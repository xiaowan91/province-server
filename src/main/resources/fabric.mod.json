{
  "schemaVersion": 1,
  "id": "mc-province",
  "version": "${version}",
  "name": "Province · 联机版",
  "description": "基于 Shuuki_ 原作 Province（MIT 协议）的 1.21.7 联机移植版。原作者：Shuuki_；本版由 Xiaowanwan 移植到 Fabric 1.21.7，并新增服务端同步（所有玩家共享区划）与区划归属权限。非官方版本，请以原作者版本为准。注意：与原版使用相同 mod id（mc-province），请勿同时安装，本模组可直接替代原版。",
  "authors": ["Shuuki_ (Original Author)", "Xiaowanwan (1.21.7 Port & Multiplayer Sync)"],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/xiaowan91/province-server",
    "issues": "https://github.com/xiaowan91/province-server/issues"
  },
  "icon": "assets/mc-province/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.mcprovince.McProvince"],
    "client": ["com.mcprovince.McProvince"]
  },
  "mixins": [
    "mc-province.mixins.json",
    "mc-province.minimap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21.7",
    "java": ">=21",
    "fabric-api": "*",
    "xaeroworldmap": ">=1.39.0"
  }
}
